<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pathology Report</title>
    <style>
        @page {
            margin: 0;
            size: A4;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', 'Helvetica', sans-serif;
            color: #263238;
            font-size: 11px;
            line-height: 1.4;
            background: white;
        }

        .report-container {
            padding: 30px 40px;
            position: relative;
            min-height: 297mm;
            width: 210mm;
            margin: 0 auto;
        }

        /* Watermark */
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-15deg);
            opacity: 0.03;
            z-index: 0;
            width: 400px;
            pointer-events: none;
        }

        /* Header Styles */
        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #333;
            padding-bottom: 12px;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo {
            width: 70px;
            height: 70px;
        }

        .company-name {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .company-name h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
            letter-spacing: 1px;
        }

        .name-life {
            color: #d32f2f;
            font-family: 'Arial Black', sans-serif;
        }

        .name-diagnostic {
            color: #1565c0;
            margin-top: 2px;
            font-family: 'Arial Black', sans-serif;
        }

        .header-info {
            text-align: right;
            max-width: 280px;
        }

        .header-info h2 {
            margin: 0 0 6px 0;
            font-size: 13px;
            color: #1565c0;
            font-weight: bold;
        }

        .header-bullets {
            list-style: none;
            padding: 0;
            font-size: 9px;
            line-height: 1.6;
        }

        .header-bullets li {
            position: relative;
            margin-bottom: 2px;
        }

        .header-bullets li::before {
            content: "●";
            color: #d32f2f;
            margin-right: 4px;
            font-size: 8px;
        }

        /* Patient Info Section */
        .patient-info-box {
            border: 1px solid #333;
            display: flex;
            padding: 12px 15px;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
            background: white;
        }

        .info-col {
            flex: 1;
        }

        .info-row {
            display: flex;
            margin-bottom: 6px;
            font-size: 9.5px;
        }

        .info-label {
            font-weight: bold;
            width: 110px;
            color: #263238;
        }

        .info-value {
            color: #263238;
            flex: 1;
        }

        /* Section Header */
        .section-header {
            font-weight: bold;
            font-size: 11px;
            margin: 18px 0 8px 0;
            color: #263238;
            text-transform: uppercase;
            position: relative;
            z-index: 1;
        }

        /* Table Styles */
        .results-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            position: relative;
            z-index: 1;
            background: white;
        }

        .table-header {
            background-color: #e3f2fd;
            font-weight: bold;
            text-align: left;
        }

        .table-header th {
            padding: 8px 10px;
            border: 1px solid #333;
            font-size: 10px;
            color: #1565c0;
        }

        .test-row {
            background-color: #f5f5f5;
            font-weight: bold;
        }

        .test-row td {
            padding: 7px 10px;
            border: 1px solid #333;
            font-size: 10px;
        }

        .param-row td {
            padding: 6px 10px;
            border: 1px solid #b0b0b0;
            font-size: 9.5px;
        }

        .param-row:nth-child(even) {
            background-color: #fafafa;
        }

        .text-center {
            text-align: center;
        }

        /* Footer Styles */
        footer {
            position: absolute;
            bottom: 40px;
            left: 40px;
            right: 40px;
            padding-top: 15px;
            z-index: 1;
        }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            padding: 0 50px;
        }

        .sig-box {
            text-align: center;
            width: 180px;
        }

        .sig-label {
            font-size: 8px;
            color: #666;
            margin-bottom: 25px;
            text-align: left;
        }

        .sig-name {
            font-weight: bold;
            font-size: 11px;
            margin-bottom: 3px;
        }

        .sig-title {
            color: #263238;
            font-size: 9px;
            line-height: 1.4;
            font-weight: bold;
        }

        /* ISO Certifications */
        .certifications {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin: 15px 0;
        }

        .cert-badge {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            border: 2px solid #d4af37;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 7px;
            text-align: center;
            color: #000;
            position: relative;
        }

        .cert-badge::after {
            content: '';
            position: absolute;
            inset: 3px;
            border-radius: 50%;
            border: 1px solid #d4af37;
        }

        .iso-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
        }

        .reg-no {
            text-align: center;
            color: #1565c0;
            font-weight: bold;
            font-size: 11px;
            margin: 10px 0;
        }

        .contact-info {
            text-align: center;
            font-size: 9px;
            margin: 12px 0;
            line-height: 1.6;
        }

        .contact-info strong {
            color: #263238;
        }

        .disclaimer-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 15px;
            font-size: 8px;
            margin: 15px 0;
            color: #263238;
        }

        .disclaimer-item {
            display: flex;
            align-items: flex-start;
        }

        .bullet {
            color: #00bcd4;
            margin-right: 6px;
            font-size: 10px;
        }

        .bottom-bar {
            background-color: #fff;
            color: #d32f2f;
            text-align: center;
            padding: 8px;
            font-weight: bold;
            font-size: 14px;
            letter-spacing: 1px;
            margin: 0 -40px -30px;
            border-top: 1px solid #dee2e6;
        }

        /* Laboratory Test Report watermark on right */
        .side-watermark {
            position: absolute;
            right: 15px;
            top: 180px;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            font-size: 28px;
            font-weight: 300;
            color: rgba(0, 0, 0, 0.03);
            letter-spacing: 8px;
            z-index: 0;
            text-transform: uppercase;
        }
    </style>
</head>

<body>
    <div class="report-container">
        <!-- Watermark -->
        <% if (logo) { %>
            <img src="<%= logo %>" class="watermark" alt="Watermark">
            <% } %>

                <div class="side-watermark">LABORATORY TEST REPORT</div>

                <!-- Header -->
                <header>
                    <div class="logo-section">
                        <% if (logo) { %>
                            <img src="<%= logo %>" class="logo" alt="Logo">
                            <% } %>
                                <div class="company-name">
                                    <h1 class="name-life">Life Care</h1>
                                    <h1 class="name-diagnostic">Diagnostic</h1>
                                </div>
                    </div>
                    <div class="header-info">
                        <h2>Clinical Laboratory</h2>
                        <ul class="header-bullets">
                            <li>Fully Automated Computerized Clinical Lab</li>
                            <li>Health Check up for company ● ECG</li>
                            <li>Home Visit ● Sunday Open</li>
                        </ul>
                    </div>
                </header>

                <!-- Patient Information -->
                <div class="patient-info-box">
                    <div class="info-col">
                        <div class="info-row">
                            <div class="info-label">Patient Name :</div>
                            <div class="info-value">
                                <%= order.patientId.fullName.toUpperCase() %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Age / Sex :</div>
                            <div class="info-value">
                                <%= order.patientId.age %> / <%= order.patientId.gender %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Contact No. :</div>
                            <div class="info-value">
                                <%= order.patientId.phone %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Referred By :</div>
                            <div class="info-value">
                                <%= order.doctor ? order.doctor.name : 'SELF' %>
                            </div>
                        </div>
                    </div>
                    <div class="info-col">
                        <div class="info-row">
                            <div class="info-label">Patient ID :</div>
                            <div class="info-value">
                                <%= order.patientId.patientId %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Ref. Date & Time :</div>
                            <div class="info-value">
                                <%= new Date(order.orderDate).toLocaleString('en-IN', { day: '2-digit' ,
                                    month: '2-digit' , year: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12:
                                    true }) %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Reporting At Time :</div>
                            <div class="info-value">
                                <%= new Date().toLocaleString('en-IN', { day: '2-digit' , month: '2-digit' ,
                                    year: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12: true }) %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Collection Date & Time :</div>
                            <div class="info-value">
                                <%= new Date(order.orderDate).toLocaleString('en-IN', { day: '2-digit' ,
                                    month: '2-digit' , year: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12:
                                    true }) %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Test Results Section -->
                <div class="section-header">HAEMATOLOGY</div>

                <table class="results-table">
                    <thead>
                        <tr class="table-header">
                            <th width="40%">TEST</th>
                            <th width="15%" class="text-center">RESULT</th>
                            <th width="15%" class="text-center">UNIT</th>
                            <th width="30%">BIOLOGICAL REF RANGE</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.tests.forEach(test=> { %>
                            <tr class="test-row">
                                <td colspan="4">
                                    <%= test.testName || test.testId.testName %>
                                </td>
                            </tr>
                            <% if (test.results && test.results.length> 0) { %>
                                <% test.results.forEach(param=> { %>
                                    <tr class="param-row">
                                        <td style="padding-left: 20px;">
                                            <%= param.parameterName %>
                                        </td>
                                        <td class="text-center"><strong>
                                                <%= param.value %>
                                            </strong></td>
                                        <td class="text-center">
                                            <%= param.unit %>
                                        </td>
                                        <td>
                                            <% if (typeof param.referenceRange==='object' ) { %>
                                                <%= param.referenceRange.min %> - <%= param.referenceRange.max %>
                                                        <% } else { %>
                                                            <%= param.referenceRange %>
                                                                <% } %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>
                                            <% }) %>
                    </tbody>
                </table>

                <!-- Footer -->
                <footer>
                    <!-- Signatures -->
                    <div class="signatures">
                        <div class="sig-box">
                            <div class="sig-name">Mr. Mayank Patil</div>
                            <div class="sig-title">M.Sc. (Medical Biochemist)</div>
                            <div class="sig-title">Lab. Technician</div>
                        </div>
                        <div class="sig-box">
                            <div class="sig-name">Dr. A. Meshay</div>
                            <div class="sig-title">M.D Pathology</div>
                            <div class="sig-title">Reg. No. MCI - 12345</div>
                        </div>
                    </div>

                    <!-- Reg No Centered -->
                    <div class="reg-no">Reg No : QMS/22N2251</div>
                </footer>
    </div>
</body>

</html>
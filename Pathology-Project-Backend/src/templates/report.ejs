<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pathology Report</title>
    <style>
        @page {
            size: A4;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', 'Helvetica', sans-serif;
            color: #263238;
            font-size: 11px;
            line-height: 1.4;
            background: white;
        }

        .report-container {
            padding: 30px 40px;
            padding-bottom: 10px;
            position: relative;
            width: 210mm;
            margin: 0 auto;
        }

        /* Watermark */
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0.08;
            z-index: 0;
            width: 400px;
            pointer-events: none;
        }

        /* Header Styles */
        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #333;
            padding-bottom: 12px;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo {
            width: 70px;
            height: 70px;
        }

        .company-name {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .company-name h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
            letter-spacing: 1px;
        }

        .name-life {
            color: #d32f2f;
            font-family: 'Arial Black', sans-serif;
        }

        .name-diagnostic {
            color: #1565c0;
            margin-top: 2px;
            font-family: 'Arial Black', sans-serif;
        }

        .header-info {
            text-align: right;
            max-width: 280px;
        }

        .header-info h2 {
            margin: 0 0 6px 0;
            font-size: 13px;
            color: #1565c0;
            font-weight: bold;
        }

        .header-bullets {
            list-style: none;
            padding: 0;
            font-size: 9px;
            line-height: 1.6;
        }

        .header-bullets li {
            position: relative;
            margin-bottom: 2px;
        }

        .header-bullets li::before {
            content: "●";
            color: #d32f2f;
            margin-right: 4px;
            font-size: 8px;
        }

        /* Patient Info Section */
        .patient-info-box {
            border: 1px solid #333;
            display: flex;
            padding: 12px 15px;
            margin-bottom: 15px;
            position: relative;
            z-index: 1;
            background: white;
        }

        .info-col {
            flex: 1;
        }

        .info-row {
            display: flex;
            margin-bottom: 6px;
            font-size: 9.5px;
        }

        .info-label {
            font-weight: bold;
            width: 110px;
            color: #263238;
        }

        .info-value {
            color: #263238;
            flex: 1;
        }

        /* Section Header */
        .section-header {
            font-weight: bold;
            font-size: 11px;
            margin: 18px 0 8px 0;
            color: #263238;
            text-transform: uppercase;
            position: relative;
            z-index: 1;
            page-break-after: avoid;
        }

        /* Table Styles */
        .results-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            position: relative;
            z-index: 1;
            background: white;
        }

        .table-header {
            background-color: #e3f2fd;
            font-weight: bold;
            text-align: left;
        }

        .table-header th {
            padding: 8px 10px;
            border: 1px solid #333;
            font-size: 10px;
            color: #1565c0;
        }

        .test-row {
            background-color: #f5f5f5;
            font-weight: bold;
            page-break-inside: avoid;
        }

        .test-row td {
            padding: 7px 10px;
            border: 1px solid #333;
            font-size: 10px;
        }

        .param-row {
            page-break-inside: avoid;
        }

        .param-row td {
            padding: 6px 10px;
            border: 1px solid #b0b0b0;
            font-size: 9.5px;
        }

        .param-row:nth-child(even) {
            background-color: #fafafa;
        }

        .text-center {
            text-align: center;
        }

        /* Laboratory Test Report watermark on right */
        .side-watermark {
            position: absolute;
            right: 15px;
            top: 180px;
            writing-mode: vertical-rl;
            text-orientation: mixed;
            font-size: 28px;
            font-weight: 300;
            color: rgba(0, 0, 0, 0.03);
            letter-spacing: 8px;
            z-index: 0;
            text-transform: uppercase;
        }
    </style>
</head>

<body>
    <div class="report-container">
        <!-- Watermark -->
        <% if (logo) { %>
            <img src="<%= logo %>" class="watermark" alt="Watermark">
            <% } %>

                <div class="side-watermark">LABORATORY TEST REPORT</div>

                <!-- Header -->
                <header style="border-bottom: none; margin-bottom: 20px; padding-bottom: 0;">
                    <% if (typeof headerImg !=='undefined' && headerImg) { %>
                        <img src="<%= headerImg %>" style="width: 100%; display: block;">
                        <% } else { %>
                            <!-- Fallback to old header if no image -->
                            <div class="logo-section">
                                <% if (logo) { %>
                                    <img src="<%= logo %>" class="logo" alt="Logo">
                                    <% } %>
                                        <div class="company-name">
                                            <h1 class="name-life">Life Care</h1>
                                            <h1 class="name-diagnostic">Diagnostic</h1>
                                        </div>
                            </div>
                            <div class="header-info">
                                <h2>Clinical Laboratory</h2>
                                <ul class="header-bullets">
                                    <li>Fully Automated Computerized Clinical Lab</li>
                                    <li>Health Check up for company ● ECG</li>
                                    <li>Home Visit ● Sunday Open</li>
                                </ul>
                            </div>
                            <% } %>
                </header>

                <!-- Patient Information -->
                <div class="patient-info-box">
                    <div class="info-col">
                        <div class="info-row">
                            <div class="info-label">Patient Name :</div>
                            <div class="info-value">
                                <%= order.patientId.fullName.toUpperCase() %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Age / Sex :</div>
                            <div class="info-value">
                                <%= order.patientId.age %> / <%= order.patientId.gender %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Contact No. :</div>
                            <div class="info-value">
                                <%= order.patientId.phone %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Referred By :</div>
                            <div class="info-value">
                                <%= order.doctor ? order.doctor.name : 'SELF' %>
                            </div>
                        </div>
                    </div>
                    <div class="info-col">
                        <div class="info-row">
                            <div class="info-label">Patient ID :</div>
                            <div class="info-value">
                                <%= order.patientId.patientId %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Ref. Date & Time :</div>
                            <div class="info-value">
                                <%= new Date(order.orderDate).toLocaleString('en-IN', { day: '2-digit' ,
                                    month: '2-digit' , year: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12:
                                    true }) %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Reporting At Time :</div>
                            <div class="info-value">
                                <%= new Date().toLocaleString('en-IN', { day: '2-digit' , month: '2-digit' ,
                                    year: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12: true }) %>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Collection Date & Time :</div>
                            <div class="info-value">
                                <%= new Date(order.orderDate).toLocaleString('en-IN', { day: '2-digit' ,
                                    month: '2-digit' , year: 'numeric' , hour: '2-digit' , minute: '2-digit' , hour12:
                                    true }) %>
                            </div>
                        </div>
                    </div>
                </div>

                <% var deptGroups={}; if (order && order.tests && order.tests.length> 0)
                    {
                    order.tests.forEach(test => {
                    let deptName = 'GENERAL';
                    if (test.testId && test.testId.departmentId && test.testId.departmentId.name) {
                    deptName = test.testId.departmentId.name;
                    } else if (test.testId && test.testId.specialization) {
                    deptName = test.testId.specialization;
                    }
                    deptName = deptName.toUpperCase();
                    if (!deptGroups[deptName]) deptGroups[deptName] = [];
                    deptGroups[deptName].push(test);
                    });
                    }

                    var deptNames = Object.keys(deptGroups).sort();
                    %>

                    <% deptNames.forEach(function(deptName) { %>
                        <div class="section-header">
                            <%= deptName %>
                        </div>

                        <table class="results-table">
                            <thead>
                                <tr class="table-header">
                                    <th width="40%">TEST</th>
                                    <th width="15%" class="text-center">RESULT</th>
                                    <th width="15%" class="text-center">UNIT</th>
                                    <th width="30%">BIOLOGICAL REF RANGE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% deptGroups[deptName].forEach(test=> { %>
                                    <tr class="test-row">
                                        <td colspan="4">
                                            <%= test.testName || test.testId.testName %>
                                        </td>
                                    </tr>
                                    <% if (test.results && test.results.length> 0) { %>
                                        <% test.results.forEach(param=> { %>
                                            <tr class="param-row">
                                                <td style="padding-left: 20px;">
                                                    <%= param.parameterName %>
                                                </td>
                                                <td class="text-center"><strong>
                                                        <%= param.value %>
                                                    </strong></td>
                                                <td class="text-center">
                                                    <%= param.unit %>
                                                </td>
                                                <td>
                                                    <% if (param.referenceRange && param.referenceRange.displayText) {
                                                        %>
                                                        <%= param.referenceRange.displayText %>
                                                            <% } else if (typeof param.referenceRange==='object' &&
                                                                param.referenceRange !==null && param.referenceRange.min
                                                                !=null && param.referenceRange.max !=null) { %>
                                                                <%= param.referenceRange.min %> - <%=
                                                                        param.referenceRange.max %>
                                                                        <% } else if (param.referenceRange) { %>
                                                                            <%= param.referenceRange %>
                                                                                <% } else { %>
                                                                                    -
                                                                                    <% } %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } %>
                                                    <% }) %>
                            </tbody>
                        </table>
                        <% }) %>

                            <!-- Footer is rendered by Puppeteer's displayHeaderFooter -->
    </div>
</body>

</html>